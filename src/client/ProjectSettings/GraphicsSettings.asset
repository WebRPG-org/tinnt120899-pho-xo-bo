%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
# Khoa hang isometric (docs/art-style.md §7):
# Transparency Sort Mode = Custom Axis, Transparency Sort Axis = (0, 1, -0.26).
# Khong doi hang nay — sort sai la loi hien thi kho debug.
--- !u!30 &1
GraphicsSettings:
  m_ObjectHideFlags: 0
  serializedVersion: 15
  m_Deferred:
    m_Mode: 0
    m_Shader: {fileID: 0}
  m_DeferredPlus:
    m_Mode: 0
    m_Shader: {fileID: 0}
  m_AlwaysIncludedShaders: []
  m_PreloadedShaders: []
  m_SpritesDefaultMaterial: {fileID: 0}
  m_CustomRenderPipeline: {fileID: 0}
  m_TransparencySortMode: 2
  m_TransparencySortAxis: {x: 0, y: 1, z: -0.26}
  m_DefaultRenderingPath: 1
  m_DefaultMobileRenderingPath: 1
  m_TierSettings: []
  m_LightmapStripping: 0
  m_FogStripping: 0
  m_InstancingStripping: 0
  m_LightmapKeepPlain: 1
  m_LightmapKeepDirCombined: 1
  m_LightmapKeepDynamicPlain: 1
  m_LightmapKeepDynamicDirCombined: 1
  m_LightmapKeepShadowMask: 1
  m_LightmapKeepSubtractive: 1
  m_FogKeepLinear: 1
  m_FogKeepExp: 1
  m_FogKeepExp2: 1
  m_InstancingKeepVariants: 1
